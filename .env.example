# Zyntai Environment Configuration Template
# Copy this file to .env and supply your environment credentials

# Application
VITE_APP_NAME=Zyntai
VITE_APP_URL=http://localhost:3000

# Optional Supabase Integration (Realtime database & Auth)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional Analytics & Telemetry
VITE_ANALYTICS_ID=
